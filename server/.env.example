# Backend environment variables.
# Copy this file to .env for local development. Never commit .env.

# HTTP port. Locally: 5000. On managed hosts (Render, Railway, Heroku)
# the platform sets PORT automatically - leave this unset in production.
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/homigo
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/homigo?retryWrites=true&w=majority
MONGO_URI=

# JWT signing secret. Use a long, random, hard-to-guess value in production.
# Anything that leaks this must be considered compromised.
JWT_SECRET=

# Allowed frontend origins for CORS, comma-separated.
# Local development origins (http://localhost:5173, http://127.0.0.1:5173)
# are ALWAYS allowed - you only need to list production and preview URLs here.
# Examples:
#   FRONTEND_URL=https://homigo.vercel.app
#   FRONTEND_URL=https://homigo.vercel.app,https://homigo-staging.vercel.app
FRONTEND_URL=
