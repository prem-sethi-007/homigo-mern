# Frontend environment variables.
# Copy this file to .env for local development. Never commit .env.
#
# Only variables prefixed VITE_ are exposed to the browser.
# Vite embeds them at BUILD time (npm run build), not at runtime -
# so a production build needs VITE_API_URL set before "vite build" runs.

# Base URL of the HOMIGO backend API (must include the /api suffix).
# Local dev: point at the local server.
# Vercel:    set this in the Project's Environment Variables to the
#            Render backend URL, e.g. https://homigo-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
